cat > .gitignore <<'EOF'
# Node.js dependencies
node_modules/

# Build output
dist/
build/

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.*.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
health_log.txt

# Test and coverage output
coverage/
.nyc_output/

# Cache
.cache/
.parcel-cache/
.tmp/
temp/

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# IDE files
.idea/
*.swp
*.swo

# Local configuration
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
*.tfvars
!*.example.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Kubernetes credentials and secrets
.kube/
kubeconfig
kubeconfig.*
*-secret.yaml
secret*.yaml

# Cloud credentials
.aws/
.gcloud/
*.pem
*.key
*.p12
*.pfx
EOF

health_log.txt
health_log.txt.1
health_log.txt.2
health_log.txt.3