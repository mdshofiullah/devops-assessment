        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "count(count by (name) (container_cpu_usage_seconds_total{job=\"cadvisor\", name!=\"\", image!=\"\"}))",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Containers Reporting Metrics",
      "type": "stat"
    }
